# Auto detect text files and perform LF normalization
* text=auto

# Scripts and source files using LF
gradlew text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.properties text eol=lf

# Windows batch files using CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.webp binary
*.keystore binary
